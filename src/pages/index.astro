---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

// ─── Fill these in ────────────────────────────────────────────────
const name = 'Alaa Eddine Ayadi';
const tagline = 'Software Engineer'; // your role / one-line pitch

// A short intro. One or two sentences is plenty.
const intro =
	'I build software. This is a placeholder — replace it with a couple of sentences about what you do and what you are looking for.';

// Links shown at the bottom. Delete any you do not want; add your own.
const links = [
	{ label: 'Email', href: 'mailto:ayadi.alaa.e@gmail.com' },
	{ label: 'GitHub', href: 'https://github.com/TheAladin' },
	{ label: 'LinkedIn', href: 'https://www.linkedin.com/in/alaa-eddine-ayadi-7bb416227' },
	// { label: 'Résumé', href: '/resume.pdf' },
];
// ──────────────────────────────────────────────────────────────────
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<main>
			<h1>{name}</h1>
			<p class="tagline">{tagline}</p>
			<p>{intro}</p>
			<ul class="links">
				{
					links.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>

<style>
	main {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.tagline {
		color: rgb(var(--gray));
		font-size: 1.25em;
		margin-top: -0.25em;
	}
	.links {
		list-style: none;
		padding: 0;
		margin: 1.5em 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
	}
	.links a {
		text-decoration: none;
		font-weight: 700;
	}
	.links a:hover {
		text-decoration: underline;
	}
</style>
