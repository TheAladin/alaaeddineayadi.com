---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SECTIONS, SITE_DESCRIPTION, SITE_TITLE, SOCIAL_LINKS } from '../consts';

const name = 'Alaa Eddine Ayadi';
const tagline = '';
const photo = '/profile.jpg';

// Each string is its own paragraph. The section blurbs below live in consts.ts.
const bio = ['Hi, I am Alaa Eddine, I write here about stuff that piques my curiosity.'];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<img class="avatar" src={photo} alt={name} width="140" height="140" />
				<div>
					<h1>{name}</h1>
					<p class="tagline">{tagline}</p>
				</div>
			</section>

			{bio.map((paragraph) => <p>{paragraph}</p>)}

			{
				SECTIONS.map((section) => (
					<p>
						<a href={`/${section.slug}`}>{section.label}</a>: {section.blurb}
					</p>
				))
			}

			<ul class="links">
				{
					SOCIAL_LINKS.map((link) => (
						<li>
							<a href={link.href}>{link.label}</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		display: flex;
		align-items: center;
		gap: 1.5em;
		margin-bottom: 1.5em;
	}
	.avatar {
		width: 140px;
		height: 140px;
		border-radius: 50%;
		object-fit: cover;
		flex-shrink: 0;
	}
	.hero h1 {
		margin-bottom: 0.1em;
	}
	.tagline {
		color: rgb(var(--gray));
		font-size: 1.25em;
		margin: 0;
	}
	.links {
		list-style: none;
		padding: 0;
		margin: 2em 0 0;
		display: flex;
		flex-wrap: wrap;
		gap: 1.25em;
	}
	.links a {
		text-decoration: none;
		font-weight: 700;
	}
	.links a:hover {
		text-decoration: underline;
	}
	@media (max-width: 600px) {
		.hero {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
