---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SECTIONS, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	return SECTIONS.map((section) => ({ params: { section: section.slug }, props: section }));
}

const { slug, label, blurb } = Astro.props;

// Posts live in src/content/blog/<slug>/, so the folder decides the section.
const posts = (await getCollection('blog'))
	.filter((post) => post.id.startsWith(`${slug}/`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${label} · ${SITE_TITLE}`} description={blurb} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{label}</h1>
			<p>{blurb}</p>
			{
				posts.length === 0 ? (
					<p class="empty">Nothing here yet — check back soon.</p>
				) : (
					<ul class="posts">
						{posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<p class="date">
									<FormattedDate date={post.data.pubDate} />
								</p>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.posts {
		list-style: none;
		padding: 0;
	}
	.posts li {
		margin-bottom: 1.5em;
	}
	.posts a {
		font-size: 1.2em;
		text-decoration: none;
	}
	.posts a:hover {
		text-decoration: underline;
	}
	.date,
	.empty {
		margin: 0;
		color: rgb(var(--gray));
	}
</style>
